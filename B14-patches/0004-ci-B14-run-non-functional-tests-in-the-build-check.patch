From: Pranathi <169073127+tlpranathi@users.noreply.github.com>
Date: Thu, 29 Oct 2026 13:29:29 +0000
Subject: [PATCH 4/5] ci(B14): run non-functional tests in the build check

---
 .github/workflows/ci.yml | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 70aaf8c..6bcd7e7 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -26,3 +26,12 @@ jobs:
 
       - name: Run admin train management tests
         run: g++ -std=c++17 -Wall -Wextra -pedantic -Iinclude tests/test_admin_trains.cpp src/AdminModule.cpp src/TrainModule.cpp src/FileModule.cpp -o test_admin_trains && ./test_admin_trains
+
+      - name: Run NFR performance test (TC-NFR-01)
+        run: g++ -std=c++17 -Wall -Wextra -pedantic -Iinclude tests/test_nfr_performance.cpp src/BookingModule.cpp src/FareModule.cpp src/FileModule.cpp src/SearchModule.cpp src/TicketModule.cpp src/TrainModule.cpp src/ValidationModule.cpp -o test_nfr_performance && ./test_nfr_performance
+
+      - name: Run NFR seat consistency test (TC-NFR-02)
+        run: g++ -std=c++17 -Wall -Wextra -pedantic -Iinclude tests/test_nfr_seats.cpp src/BookingModule.cpp src/FareModule.cpp src/FileModule.cpp src/TicketModule.cpp src/TrainModule.cpp src/ValidationModule.cpp -o test_nfr_seats && ./test_nfr_seats
+
+      - name: Run NFR usability test (TC-NFR-03)
+        run: tests/test_nfr_usability.sh ./railway
